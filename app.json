{
  "expo": {
    "name": "quran-mushaf-app",
    "slug": "quran-mushaf-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.usamar.quranmushafapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": [
      "assets/fonts/**/*",
      "assets/databases/**/*",
      "assets/quran-simple.txt"
    ],
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "92e644ca-75c1-4745-a365-be8e2ed2ad9f"
      }
    },
    "owner": "usamar"
  }
}
